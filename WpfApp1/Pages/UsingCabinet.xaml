<Page x:Class="WpfApp1.Pages.UsingCabinet"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет BanID" Height="550" Width="800">
    <Grid Background="#F4F7F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#2C3E50" CornerRadius="0,20,20,0">
            <StackPanel Margin="20">
                <TextBlock Text="BanID" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,30"/>

                <TextBlock Text="Заявки на действия:" Foreground="#BDC3C7" Margin="0,10,0,5"/>
                <ComboBox x:Name="RequestCombo" Height="30" Margin="0,0,0,10">
                    <ComboBoxItem Content="Открытие вклада"/>
                    <ComboBoxItem Content="Открытие счета"/>
                    <ComboBoxItem Content="Смена персональных данных"/>
                    <ComboBoxItem Content="Закрытие счета"/>
                </ComboBox>

                <Button Content="Отправить заявку" Click="SendRequest_Click" Height="35" Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <Separator Margin="0,30" Background="#34495E"/>
                <Button Content="Выход" Click="Logout_Click" Background="Transparent" Foreground="#E74C3C" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30">
            <StackPanel x:Name="PrintArea">
                <TextBlock x:Name="WelcomeLabel" Text="Добро пожаловать!" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>
                <Border Background="White" CornerRadius="10" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="1" Color="#E0E0E0"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Ваши персональные данные" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock x:Name="UserDataLabel" Text="Данные загружаются..." TextWrapping="Wrap" Foreground="#7F8C8D" Margin="0,0,0,20"/>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="Детальная выписка по счету" FontWeight="Bold" FontSize="14" Margin="0,10,0,10"/>
                        <TextBlock x:Name="AccNumberText" Text="Счет: №00000000000000000000" Foreground="#34495E"/>
                        <TextBlock x:Name="AccBalanceText" Text="Доступный остаток: 0,00 руб." FontSize="18" Foreground="#27AE60" FontWeight="Bold" Margin="0,5,0,0"/>
                        <TextBlock Text="Статус счета: Активен" FontSize="12" Foreground="#95A5A6"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="🖨 Печать выписки" Click="Print_Click" Width="200" Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Page>